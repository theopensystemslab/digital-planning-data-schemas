{
  "name": "digital-planning-data-schemas",
  "version": "0.7.7",
  "description": "Digital Planning Data schemas",
  "main": "schema/schema.json",
  "files": [
    "types",
    "schemas",
    "examples"
  ],
  "exports": {
    "./types/*": "./types/*",
    "./schemas/*": "./schemas/*",
    "./examples/*": "./examples/*"
  },
  "scripts": {
    "build": "pnpm build-schema && pnpm build-json-examples",
    "build-json-examples": "pnpm ts-node scripts/build-json-examples.ts",
    "build-schema": "bash scripts/build-schema.sh",
    "lint": "gts lint",
    "check": "tsc --noEmit",
    "fix": "gts fix",
    "test": "pnpm build-schema && vitest",
    "prepare": "husky install",
    "compile": "tsc",
    "config": "tsc --showConfig",
    "package": "pnpm build && pnpm compile && pnpm package:copy-dts && pnpm pack && pnpm package:clean-dts",
    "package:copy-dts": "cpx \"build/types/**/*.d.ts*\" types",
    "package:clean-dts": "rimraf --verbose --glob types/**/*.d.ts*"
  },
  "keywords": [],
  "author": "Open Systems Lab",
  "license": "MPL2",
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "25.6.0",
    "cpx": "^1.5.0",
    "gts": "^7.0.0",
    "husky": "^8.0.0",
    "jsonschema": "^1.4.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.5.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "ts-json-schema-generator": "2.3.0",
    "ts-node": "^10.9.2"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "fsevents"
    ]
  }
}
